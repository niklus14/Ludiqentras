# IGDB MCP (Twitch OAuth credentials — register at dev.twitch.tv)
IGDB_MCP_CLIENT_ID=
IGDB_MCP_CLIENT_SECRET=

# Grok (xAI — for concept extraction, discovery ranking, follow-up questions)
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Steam (optional — for corpus building and detail fetching)
STEAM_WEB_API_KEY=

# Optional
CORPUS_PATH=./data
DEMO_MODE=false

# Optional legacy corpus embeddings (not needed by live discovery)
OPENAI_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Shared expiring discovery previews for serverless deployments (Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
